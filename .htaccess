Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Bloquear acceso HTTP directo a codigo interno y secretos cuando todo vive en htdocs.
RewriteRule ^(?:app|vendor|logs|tools|qa|documentacion|puntos_de_acopio)(?:/|$) - [F,L,NC]
RewriteRule (^|/)(?:\.git|\.env|composer\.(?:json|lock)|database.*\.sql|.*\.local\.php|.*\.(?:bak|old|orig|tmp|log|zip|rar|sql|ini|sh|swp|dist|example))$ - [F,L,NC]

# Archivos ocultos (los que empiezan por punto) fuera del alcance web.
#
# Se hace con <FilesMatch> y no con RewriteRule a proposito. La version con
# rewrite dependia de como el servidor recorta la ruta antes de evaluar la
# regla, y ese detalle cambia entre configuraciones: en un host podia acabar
# bloqueando la peticion a la raiz y devolver un 403 en toda la web.
# <FilesMatch> mira el nombre del archivo y nada mas: no hay ambiguedad.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Charset explicito: evita mojibake si el host responde con latin-1 por defecto.
AddDefaultCharset UTF-8

# Algunos hosts compartidos no reconocen webp/avif y devuelven imagenes rotas.
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg
    AddType application/javascript .js
    AddType text/css .css
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"

    # La Content-Security-Policy se envia desde PHP (app/views/layouts/header.php)
    # porque usa un nonce distinto en cada peticion, que Apache no puede generar.

    # El endpoint del reporte envia correos: fuera de buscadores y de cache.
    <FilesMatch "^index\.php$">
        Header set X-Permitted-Cross-Domain-Policies "none"
    </FilesMatch>

    # El HTML lo genera PHP y cambia con cada despliegue: siempre revalidar,
    # para que una version nueva se vea al instante y no dentro de horas.
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # CSS y JS se piden con ?v=<filemtime>, asi que la URL cambia sola cuando
    # el archivo cambia. Con eso es seguro cachearlos de forma agresiva.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
